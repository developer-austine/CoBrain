# TLS terminator for cobrain.co.
#
# docker-compose.prod.yml binds `app` to 127.0.0.1:3000 on purpose — nothing in
# the stack is meant to face the internet directly. This is the one process that
# does, and it is deliberately the only one with published ports.
#
# Caddy obtains and renews Let's Encrypt certificates on its own, so there is no
# certbot cron to forget and no renewal that expires over a holiday. Point an A
# record for cobrain.co (and www) at the host and it provisions on first request.

{
	# Where expiry and renewal-failure notices go.
	email ops@cobrain.co
}

cobrain.co {
	encode zstd gzip

	# The app is on the compose network; `app` resolves to the container.
	reverse_proxy app:3000 {
		# Without these the app sees Caddy's address as the client, which
		# breaks rate limiting and puts the wrong host in redirects.
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# HSTS is set here rather than in the app so it covers responses the app
	# never produces — 502s while a release restarts, and static errors.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Caddy advertising its version buys an attacker a version to target.
		-Server
	}

	# Health checks are polled every few seconds by CI and any uptime monitor;
	# logging them drowns the access log in noise.
	log {
		output stdout
		format json
	}
}

# Canonical host: one origin for cookies, OAuth redirect URIs and absolute URLs.
# Better Auth issues cookies for BETTER_AUTH_URL, so a session created on www
# would not be seen on the apex.
www.cobrain.co {
	redir https://cobrain.co{uri} permanent
}
