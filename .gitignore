# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.venv
backend/venv

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# clerk configuration (can include secrets)
/.clerk/

# forecasting engine artefacts — tenant features, forecasts and model weights.
# Generated per deployment; the feature and forecast stores hold customer data.
backend/m_learning/.feature_store/
backend/m_learning/.forecast_store/
backend/m_learning/.external_cache/
backend/m_learning/checkpoints/

# python bytecode
__pycache__/
*.py[cod]
